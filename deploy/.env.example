# deploy/.env.example — copy to .env and fill in. Never commit a real .env.
#
# §2.2 / §2.20 of ENGINEERING_PLAN_v2.md
# All secrets must be high-entropy. CI fails on defaults.

# ── Deployment mode ────────────────────────────────────────────────────────
DEPLOYMENT_MODE=local-private            # local-private | local-plus-integrations
RUNTIME_TOPOLOGY=compose                 # compose | systemd (must match deploy/MODE)

# ── Service ports (chomp, measured 2026-08-11) ─────────────────────────────
API_HOST=127.0.0.1
API_PORT=8090
WEB_HOST=127.0.0.1
WEB_PORT=3090
LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_UDP_PORT_RANGE=50000-50100

# ── llama.cpp llama-server (I1: colocated, 127.0.0.1 only) ────────────────
LLAMA_BASE_URL=http://127.0.0.1:8081/v1
LLAMA_API_KEY=change-me-high-entropy      # mandatory; refuse boot if empty
LLAMA_CTX_SIZE=4096
LLAMA_N_GPU_LAYERS=99
LLAMA_PARALLEL=1
LLAMA_MODEL_PATH=/abs/path/to/qwen2.5-3b-instruct-q4_k_m.gguf
LLAMA_GPU_LOCK=/var/run/voice-agent/gpu.lock

# ── STT (faster-whisper) ───────────────────────────────────────────────────
WHISPER_MODEL=small
WHISPER_DEVICE=auto                       # auto | cuda | cpu
WHISPER_COMPUTE_TYPE=int8_float16

# ── TTS (Piper, CPU) ───────────────────────────────────────────────────────
PIPER_VOICE_EN=/abs/path/to/piper/en_US-amy-low.onnx
PIPER_VOICE_HI=/abs/path/to/piper/hi_IN-speech_low.onnx

# ── LiveKit ────────────────────────────────────────────────────────────────
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me-high-entropy

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://voice:change-me@127.0.0.1:5432/voice
# SQLite is permitted only for isolated tests/dev fixtures.
# DATABASE_URL=sqlite+aiosqlite:///./var/dev.sqlite3

# ── Privacy (I7) ───────────────────────────────────────────────────────────
# Empty in local-private. Comma-separated allowlist in local-plus-integrations.
EGRESS_ALLOWLIST=

# ── Coturn (mobile, optional) ──────────────────────────────────────────────
COTURN_ENABLED=false
COTURN_REALM=voice.local
COTURN_SHARED_SECRET=change-me

# ── Observability ──────────────────────────────────────────────────────────
OTEL_EXPORTER=console                     # console | otlp
LOG_LEVEL=INFO
LOG_PII_REDACT=true

# ── Feature flags ──────────────────────────────────────────────────────────
FEATURE_OUTBOUND_DIAL=false               # compiled out in v1
FEATURE_HINDI_PROFILE=false               # opt-in; requires assets
FEATURE_TWILIO_PSTN=false
FEATURE_TWILIO_SMS=false
FEATURE_CALENDAR_ADAPTER=false
FEATURE_CLOUD_LLM=false
FEATURE_CLOUD_STT=false
FEATURE_CLOUD_TTS=false

# ── Single-session admission (I8) ──────────────────────────────────────────
MAX_CONCURRENT_SESSIONS=1
FREE_VRAM_MB_MIN=1200

# ── Disk preflight (§2.20) ─────────────────────────────────────────────────
DISK_FREE_GB_MIN=25
